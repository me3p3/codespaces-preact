{
  "image": "mcr.microsoft.com/devcontainers/universal:1",
  "hostRequirements": {
    "cpus": 1
  },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "npm install",
  "postCreateCommand": "",
  "postAttachCommand": {
    "server": "npm dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "dir/index.jsx"
      ]
    }
  },
  "portsAttributes": {
    "mp3audio": {
      "label": "Application",
      "onAutoForward": "openzip"
    }
  },
  "forwardPorts": [mp3audio]
}
